APP_NAME="Daygun Research Center"
APP_ENV=production
APP_KEY=GENERATED_BY_PACKAGE_BUILDER
APP_DEBUG=false
APP_URL=https://drcproject.org
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ISI_NAMA_DATABASE_CPANEL
DB_USERNAME=ISI_USER_DATABASE_CPANEL
DB_PASSWORD="ISI_PASSWORD_DATABASE_CPANEL"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LOG_CHANNEL=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

MAIL_MAILER=log
MAIL_FROM_ADDRESS="daygunrisetcenter@gmail.com"
MAIL_FROM_NAME="Daygun Research Center"
